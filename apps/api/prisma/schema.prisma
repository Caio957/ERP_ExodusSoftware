// ============================================================================
// Exodus Software - Prisma Schema
// ----------------------------------------------------------------------------
// Base fornecida no briefing, CORRIGIDA e ESTENDIDA (decisão aprovada):
//  [+] User.passwordHash            -> auth JWT/bcrypt (model original não tinha)
//  [+] ProductVariant.batch         -> lote obrigatório (rastreabilidade 4.1)
//  [+] Person endereço + relações   -> BrasilAPI (4.2) e integridade
//  [~] Person.document opcional      -> clientes de balcão sem CPF; @unique
//                                       continua válido (NULLs não colidem no PG)
//  [+] SupplierProductMapping       -> De/Para fornecedor↔variante (4.3)
//  [+] Relações faltantes           -> Invoice→supplier, CashRegister→user,
//                                       Sale→user/client, FinancialAccount→invoice/person
//  [+] StockMovement                -> razão (ledger) de estoque p/ auditoria e 4.6
//  [+] Company + companyId          -> Multi-Tenant (Plano Mestre V2.0):
//                                       Fase 1 introduziu a coluna como nullable
//                                       em todas as tabelas vitais (zero-impacto);
//                                       Fase 2 fez o backfill de todo dado
//                                       pré-existente para o tenant "Inquilino
//                                       Zero"; Fase 4 (ESTA) torna `companyId`
//                                       OBRIGATÓRIO em todas as tabelas de dados
//                                       de negócio. Exceção deliberada: `User`
//                                       continua com `companyId` opcional — ver
//                                       nota no próprio model, abaixo, sobre o
//                                       papel SYSTEM_ADMIN (§4 do Plano Mestre).
//                                       Constraints @unique pré-existentes
//                                       (email, sku, barcode, document,
//                                       accessKey) permaneceram GLOBAIS até a
//                                       Fase 4 — risco real de colisão entre
//                                       tenants (ex.: dois lojistas com o
//                                       mesmo código de barras de fabricante,
//                                       ou o mesmo CPF/CNPJ de fornecedor).
//                                       Rodada seguinte (constraints globais
//                                       → tenant-scoped) trocou User.email,
//                                       ProductVariant.sku/barcode e
//                                       Person.document por
//                                       @@unique([companyId, campo]).
//                                       Ficaram deliberadamente GLOBAIS:
//                                       Company.document (identidade do
//                                       próprio tenant) e Invoice.accessKey
//                                       (chave de acesso da NFe — identificador
//                                       único nacional emitido pela Receita,
//                                       escopar por tenant não evitaria nada).
//                                       Login por e-mail (routes/auth.ts)
//                                       adaptado: valida a senha contra todas
//                                       as ocorrências do e-mail e só pede a
//                                       empresa explicitamente se mais de uma
//                                       conferir (ver `loginNeedsCompanySchema`,
//                                       packages/shared/src/schemas/auth.ts).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 0. MULTI-TENANT (Plano Mestre V2.0) ----------------------------------------
model Company {
  id        String   @id @default(uuid())
  name      String
  document  String?  @unique // CNPJ do tenant (opcional nesta fase)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  products                Product[]
  productVariants         ProductVariant[]
  persons                 Person[]
  invoices                Invoice[]
  invoiceItems            InvoiceItem[]
  supplierProductMappings SupplierProductMapping[]
  cashRegisters           CashRegister[]
  cashTransactions        CashTransaction[]
  sales                   Sale[]
  saleItems               SaleItem[]
  salePayments            SalePayment[]
  stockMovements          StockMovement[]
  settings                Setting[]
  financialAccounts       FinancialAccount[]
  accountSettlements      AccountSettlement[]
}

// 0b. AUDITORIA (Plano Mestre V2.0, Frente 4 — Impersonate) ------------------
// Sem @relation de propósito: um log de auditoria precisa sobreviver à
// exclusão do usuário/empresa que ele referencia (é o próprio registro
// jurídico de "quem acessou o quê"), então fica desacoplado de qualquer
// FK/onDelete — só strings simples, indexadas para consulta. Também não
// carrega `companyId` — é uma tabela GLOBAL (o auditor atravessa tenants por
// definição), nunca escopada por `withTenant`.
model AuditLog {
  id              String   @id @default(uuid())
  adminUserId     String // usuário de suporte (Exodus) que executou a ação
  targetCompanyId String // empresa (tenant) acessada/impersonada
  action          String // ex.: 'IMPERSONATE_LOGIN'
  createdAt       DateTime @default(now())

  @@index([adminUserId])
  @@index([targetCompanyId])
}

// 1. USUÁRIOS E RBAC ---------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  // Deixou de ser @unique sozinho (Plano Mestre V2.0 — constraints globais →
  // tenant-scoped): o mesmo e-mail pode existir em empresas diferentes
  // (ex.: contador/franqueado com acesso a várias lojas). Login por e-mail
  // passou a validar a senha contra todas as ocorrências e só pede a
  // empresa explicitamente se mais de uma conferir (routes/auth.ts).
  email        String
  name         String
  passwordHash String
  role         String   // 'ADMIN' | 'CASHIER' (futuro: 'SYSTEM_ADMIN')
  // null = usa padrão do papel; array de chaves de páginas para restringir CASHIER
  allowedPages Json?
  createdAt    DateTime @default(now())

  // Multi-tenant — DELIBERADAMENTE continua opcional na Fase 4 (diferente das
  // outras 15 tabelas). O Plano Mestre V2.0 (§4, Governança/Auditoria) prevê
  // um papel SYSTEM_ADMIN capaz de "Assumir Identidade" (impersonate) entre
  // MÚLTIPLOS tenants — esse usuário, por definição, não pertence a uma única
  // empresa. Forçar `companyId` obrigatório aqui inviabilizaria esse papel
  // futuro. Todo usuário ADMIN/CASHIER real hoje já tem `companyId` preenchido
  // pelo backfill (Fase 2); `null` fica reservado para contas globais.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  cashRegisters CashRegister[]
  sales         Sale[]

  // ⚠️ companyId nullable aqui (nota acima) significa que dois usuários
  // globais (SYSTEM_ADMIN, companyId=null) poderiam ter o mesmo e-mail sem
  // violar esta constraint (Postgres trata NULL como distinto de NULL em
  // índice único). Sem risco prático hoje — não existe nenhum caminho de
  // código que crie usuário com companyId null (/auth/register sempre usa
  // tenantDb). Reavaliar se o papel SYSTEM_ADMIN for implementado de fato.
  @@unique([companyId, email])
  @@index([companyId])
}

// 2. PRODUTOS E VARIAÇÕES ----------------------------------------------------
model Product {
  id        String   @id @default(uuid())
  code      Int      @unique @default(autoincrement()) // código sequencial de produto (somente leitura)
  name      String
  brand     String
  group     String
  subgroup  String?
  // Quando true, as variantes deste produto exigem lote e validade (4.1).
  // Quando false, lote/validade são opcionais (configurável por produto).
  tracksLotValidity Boolean @default(false)
  variants  ProductVariant[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant — obrigatório a partir da Fase 4 (ver cabeçalho do arquivo)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([brand])
  @@index([companyId])
}

model ProductVariant {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  // sku/barcode deixaram de ser @unique sozinhos (Plano Mestre V2.0 —
  // constraints globais → tenant-scoped): código de barras é atribuído pelo
  // fabricante/marca, não pela loja — duas lojas vendendo o mesmo produto
  // colidiriam sob a constraint global antiga, bloqueando o cadastro
  // legítimo de um segundo tenant. Ver @@unique([companyId, ...]) abaixo.
  sku         String
  barcode     String?
  description String
  costPrice   Decimal   @db.Decimal(10, 2)
  averageCost Decimal   @default(0) @db.Decimal(10, 2)
  salePrice   Decimal   @db.Decimal(10, 2)
  stockQty    Int       @default(0)
  batch       String? // lote (obrigatório só quando Product.tracksLotValidity)
  validity    DateTime?

  // Multi-tenant — obrigatório a partir da Fase 4 (ver cabeçalho do arquivo)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  invoiceItems    InvoiceItem[]
  saleItems       SaleItem[]
  supplierMaps    SupplierProductMapping[]
  stockMovements  StockMovement[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([productId])
  @@index([barcode])
  @@index([companyId])
}

// 3. PESSOAS -----------------------------------------------------------------
model Person {
  id       String  @id @default(uuid())
  code     Int     @unique @default(autoincrement()) // código sequencial único (clientes e fornecedores)
  type     String // 'CLIENT' | 'SUPPLIER'
  name      String
  tradeName String? // Nome fantasia (PJ) ou apelido (PF)
  // Deixou de ser @unique sozinho (Plano Mestre V2.0 — constraints globais →
  // tenant-scoped): o mesmo fornecedor/cliente (CPF/CNPJ) frequentemente
  // atende várias lojas diferentes. Ver @@unique([companyId, document]) abaixo.
  document  String? // CPF/CNPJ - opcional p/ balcão
  email     String?
  phone     String?

  // Endereço (autocompletado via BrasilAPI no cadastro de fornecedor)
  zipCode  String?
  street   String?
  number   String?
  district String?
  city     String?
  state    String?

  // Multi-tenant — obrigatório a partir da Fase 4 (ver cabeçalho do arquivo)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  invoices          Invoice[]                @relation("SupplierInvoices")
  sales             Sale[]                   @relation("ClientSales")
  financialAccounts FinancialAccount[]
  supplierMaps      SupplierProductMapping[]

  @@unique([companyId, document])
  @@index([type])
  @@index([name])
  @@index([companyId])
}

// 4. ENTRADA DE NOTAS FISCAIS ------------------------------------------------
model Invoice {
  id             String   @id @default(uuid())
  supplierId     String
  supplier       Person   @relation("SupplierInvoices", fields: [supplierId], references: [id])
  accessKey      String   @unique
  documentNumber Int? // nº sequencial do documento (compras manuais)
  nfeNumber      String? // nº da nota fiscal (nNF do XML) — nulo em compra manual
  notes          String? // observação da compra
  issueDate      DateTime
  // Data de entrada/digitação (quando o operador deu entrada no sistema) —
  // distinta de issueDate (emissão da NFe). Base para StockMovement (o
  // estoque só existe fisicamente na loja a partir da entrada real).
  entryDate      DateTime @default(now())
  totalAmount    Decimal  @db.Decimal(10, 2)
  // Landed cost: frete e outras despesas da nota, rateados proporcionalmente
  // ao valor de cada item para compor o custo real (ver lib/inventory.ts —
  // apportionLandedCost). totalAmount = soma dos itens + freight + otherExpenses.
  freight        Decimal  @default(0) @db.Decimal(10, 2)
  otherExpenses  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  // Multi-tenant — obrigatório a partir da Fase 4 (ver cabeçalho do arquivo)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  items             InvoiceItem[]
  financialAccounts FinancialAccount[]

  @@index([supplierId])
  @@index([documentNumber])
  @@index([companyId])
}

model InvoiceItem {
  id        String         @id @default(uuid())
  invoiceId String
  invoice   Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitCost  Decimal        @db.Decimal(10, 2)
  cfop      String // registrado como veio no XML (flexível) - 4.3

  // Multi-tenant — obrigatório a partir da Fase 4 (ver cabeçalho do arquivo)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([variantId])
  @@index([companyId])
}

// De/Para: associa o código/EAN do fornecedor a uma variante local (4.3).
model SupplierProductMapping {
  id               String         @id @default(uuid())
  supplierId       String
  supplier         Person         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierItemCode String // cProd do XML
  supplierBarcode  String? // cEAN do XML
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  // Multi-tenant — obrigatório a partir da Fase 4 (ver cabeçalho do arquivo)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([supplierId, supplierItemCode])
  @@index([variantId])
  @@index([companyId])
}

// 5. CAIXA E VENDAS ----------------------------------------------------------
model CashRegister {
  id          String    @id @default(uuid())
  userId      String // operador do caixa
  user        User      @relation(fields: [userId], references: [id])
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  initialCash Decimal   @db.Decimal(10, 2)
  finalCash   Decimal?  @db.Decimal(10, 2)
  status      String // 'OPEN' | 'CLOSED'
  // Tipo de caixa: 'DIARIO' (caixa físico de balcão, comportamento original)
  // ou 'BANCO' (conta bancária/digital) — mesma tabela, mesmas rotas de
  // abrir/sangria/suprimento/fechar, só filtradas por tipo. Default garante
  // que os registros já existentes continuam sendo 'DIARIO' sem migração de dados.
  type        String    @default("DIARIO")

  // Multi-tenant — obrigatório a partir da Fase 4 (ver cabeçalho do arquivo)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  transactions CashTransaction[]
  sales        Sale[]

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([companyId])
}

model CashTransaction {
  id             String       @id @default(uuid())
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  type           String // 'SUPPLY' | 'BLEED'
  amount         Decimal      @db.Decimal(10, 2)
  description    String
  createdAt      DateTime     @default(now())

  // Multi-tenant — obrigatório a partir da Fase 4 (ver cabeçalho do arquivo)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([cashRegisterId])
  @@index([companyId])
}

model Sale {
  id             String       @id @default(uuid())
  code           Int          @unique @default(autoincrement()) // NºDOC sequencial da venda
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])
  userId         String? // operador que registrou
  user           User?        @relation(fields: [userId], references: [id])
  clientId       String?
  client         Person?      @relation("ClientSales", fields: [clientId], references: [id])
  subtotal       Decimal      @default(0) @db.Decimal(10, 2) // soma dos itens (bruto)
  discount       Decimal      @default(0) @db.Decimal(10, 2) // desconto em R$
  surcharge      Decimal      @default(0) @db.Decimal(10, 2) // acréscimo em R$
  totalAmount    Decimal      @db.Decimal(10, 2) // líquido: subtotal - desconto + acréscimo
  notes          String? // observação livre da venda
  paymentMethod  String // 'PIX' | 'CREDIT' | 'DEBIT' | 'CASH'
  // false = financeiro da venda excluído (não conta no caixa/recebimentos nem
  // gera contas a receber). Reversível pela tela de Vendas.
  financialGenerated Boolean  @default(true)
  syncStatus     String       @default("SYNCED") // 'PENDING' | 'SYNCED'
  // Idempotência da fila offline (Dexie): evita venda duplicada na sync (4.4)
  clientRef      String?      @unique
  soldAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())

  // Multi-tenant — obrigatório a partir da Fase 4 (ver cabeçalho do arquivo)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  items             SaleItem[]
  payments          SalePayment[] // formas de pagamento (split / múltiplas)
  financialAccounts FinancialAccount[] // contas a receber geradas (venda a prazo)

  @@index([cashRegisterId])
  @@index([soldAt])
  @@index([companyId])
}

model SaleItem {
  id        String         @id @default(uuid())
  saleId    String
  sale      Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)

  // Multi-tenant — obrigatório a partir da Fase 4 (ver cabeçalho do arquivo)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([variantId])
  @@index([companyId])
}

// Formas de pagamento de uma venda (permite split de pagamento / "A prazo").
model SalePayment {
  id        String   @id @default(uuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    String // 'CASH' | 'PIX' | 'DEBIT' | 'CREDIT' | 'A_PRAZO'
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  // Multi-tenant — obrigatório a partir da Fase 4 (ver cabeçalho do arquivo)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([companyId])
}

// Razão de movimentações de estoque (auditoria + base p/ sugestão de compra)
model StockMovement {
  id        String         @id @default(uuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type      String // 'IN' | 'OUT' | 'ADJUST'
  quantity  Int // positivo p/ IN, negativo p/ OUT
  reason    String // 'SALE' | 'INVOICE' | 'MANUAL'
  refId     String? // id da venda/nota de origem
  // Código sequencial só para acertos de estoque (type='ADJUST') — nulo nos
  // demais tipos. StockMovement é um razão compartilhado por vendas/notas/
  // acertos, então um autoincrement de banco misturaria a numeração; o
  // código é calculado manualmente (aggregate max + 1 escopado a type='ADJUST')
  // na rota /adjust-stock, mesmo padrão de Invoice.documentNumber.
  code      Int?
  createdAt DateTime       @default(now())

  // Multi-tenant — obrigatório a partir da Fase 4 (ver cabeçalho do arquivo)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([variantId])
  @@index([createdAt])
  @@index([companyId])
}

// Configurações da loja (chave/valor JSON) — ex.: campos obrigatórios do produto.
// Multi-tenant: `key` deixou de ser a chave primária (era @id) — a PK é um
// `id` uuid próprio, e a unicidade de `key` é composta com `companyId`
// (`@@unique([companyId, key])`), permitindo que cada empresa tenha sua
// própria "company_profile"/"product_form"/etc. `companyId` obrigatório a
// partir da Fase 4 — `lib/settings.ts` (getSetting/upsertSetting) recebe o
// companyId real de cada requisição.
model Setting {
  id        String   @id @default(uuid())
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  // Multi-tenant — obrigatório a partir da Fase 4 (ver cabeçalho do arquivo)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, key])
  @@index([companyId])
}

// 6. FINANCEIRO --------------------------------------------------------------
model FinancialAccount {
  id          String    @id @default(uuid())
  code        Int       @unique @default(autoincrement()) // código sequencial do título
  type        String // 'PAYABLE' | 'RECEIVABLE'
  description String
  amount      Decimal   @db.Decimal(10, 2)
  dueDate     DateTime
  paidAt      DateTime?
  status      String // 'PENDING' | 'PARTIAL' | 'PAID'

  // Duplicatas da NFe alimentam Contas a Pagar automaticamente (4.3)
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  personId  String?
  person    Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  // Origem em venda a prazo (contas a receber). Removido ao editar/excluir a venda.
  saleId    String?
  sale      Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)

  // Multi-tenant — obrigatório a partir da Fase 4 (ver cabeçalho do arquivo)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  settlements AccountSettlement[]

  @@index([status])
  @@index([dueDate])
  @@index([invoiceId])
  @@index([saleId])
  @@index([companyId])
}

// Baixas (liquidações) de um título — permite baixa parcial e estorno (E1/E2).
model AccountSettlement {
  id                 String           @id @default(uuid())
  financialAccountId String
  account            FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  amount             Decimal          @db.Decimal(10, 2)
  paidAt             DateTime         @default(now())
  createdAt          DateTime         @default(now())

  // Multi-tenant — obrigatório a partir da Fase 4 (ver cabeçalho do arquivo)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([financialAccountId])
  @@index([companyId])
}
