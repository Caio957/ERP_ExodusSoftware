# ==========================================================================
# Exodus Software - Variáveis de ambiente (exemplo)
# Copie para apps/api/.env e ajuste os valores.
# ==========================================================================

# --- Banco de Dados -------------------------------------------------------
# Postgres local (docker-compose). Para Supabase, troque pela connection
# string do painel (Settings > Database > Connection string > URI).
DATABASE_URL="postgresql://exodus:exodus@localhost:5432/exodus?schema=public"

# --- Servidor -------------------------------------------------------------
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# --- Autenticação ---------------------------------------------------------
# Gere um valor forte: `openssl rand -hex 32`
JWT_SECRET="troque-este-segredo-em-producao-com-32-bytes-aleatorios"
JWT_EXPIRES_IN="12h"

# --- Criptografia de dados sensíveis (LGPD, ver lib/encryption.ts) --------
# 32 bytes em hex (64 caracteres) ou base64. Gere com `openssl rand -hex 32`.
# ⚠️ Trocar a chave em produção torna ILEGÍVEIS os dados já cifrados com a
# anterior — troque só via um processo de re-criptografia planejado.
ENCRYPTION_KEY="troque-por-32-bytes-em-hex-gerados-com-openssl-rand--hex-32"

# --- CORS -----------------------------------------------------------------
CORS_ORIGIN="http://localhost:5173"
